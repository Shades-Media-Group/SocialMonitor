{"data":{"ad_library_main":{"search_results_connection":{"edges":[{"node":{"collated_results":[{"ad_archive_id":"429435453322916","collation_count":1,"collation_id":"950710340295166","is_active":false,"page_id":"412679685271074","page_is_deleted":false,"snapshot":{"branded_content":null,"page_id":"412679685271074","page_is_deleted":false,"page_profile_uri":"https://www.facebook.com/mancauseni/","root_reshared_post":null,"byline":"Partidului Politic \"Mișcarea Alternativă Națională\"","disclaimer_label":"PAID_FOR_BY","page_name":"MAN Căuşeni - Mişcarea Alternativa Națională","page_profile_picture_url":"https://scontent.fkiv9-1.fna.fbcdn.net/v/t39.35426-6/466482280_1216168792818826_3358856528321297128_n.jpg?stp=dst-jpg_s60x60_tt6&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=kzG2q4qV3lgQ7kNvwFA69Z3&_nc_oc=AdoRAvfBuZ-IkFTJw3TDLLEIgWQAGBjuyBzsoMX_FLjZn6gqfyoM_yXQr0R-dsN-neM&_nc_zt=14&_nc_ht=scontent.fkiv9-1.fna&_nc_gid=hYFmbpSedWibIJl8U4jJFg&_nc_ss=7b289&oh=00_AQSbdU_IHbUQvuQ7QFZKJsE5zeTChob2Xh0LZC1XqF3CgA&oe=6AED644E","event":null,"caption":null,"cta_text":"No button","cards":[],"body":{"text":"Ion Guzun, candidatul partidului Mișcarea Alternativa Națională pentru funcția de primar în orașul Căușeni, însoțit de membrii formațiunii politice a avut în această dimineață o întâlnire cu angajații Poștei Moldovei și Moldtelecom din orașul Căușeni.\n\nUnul dintre subiectele principale discutate în cadrul întâlnirii a fost blocajul proiectului Agro Hub, crucial pentru dezvoltarea economică locală, care deși există de doi ani, încă nu a fost implementat.\n\nDe asemenea, a fost adus în discuție și un subiect sensibil legat de fondurile publice, mai exact banii dispăruți care au fost alocați pentru dezvoltarea infrastructurii orașului Căușeni.\n\nToate doleanțele și sugestiile primite de la cetățeni în cadrul acestei întâlniri au fost notate și urmează să fie analizate de experții partidului MAN, pentru a găsi soluții eficiente pentru a răspunde nevoilor locuitorilor orașului Căușeni.\n\nPe 17 noiembrie, votați Ion Guzun, candidatul partidului Mișcarea Alternativă Națională, la funcția de primar în orașul nostru !"},"cta_type":"NO_BUTTON","display_format":"MULTI_IMAGES","link_description":null,"link_url":null,"images":[{"image_crops":[],"original_image_url":"https://scontent.fkiv9-1.fna.fbcdn.net/v/t39.35426-6/466422659_8288755691228322_2040330374693340571_n.jpg?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=09iFQHJcbrgQ7kNvwFiXuCX&_nc_oc=Adqld7FzmE0CyDEBcAYxAOqtTRm0L5Gsw4QZiDmIrIJy2P5EM4RMygvakIMXhiSiJuk&_nc_zt=14&_nc_ht=scontent.fkiv9-1.fna&_nc_gid=hYFmbpSedWibIJl8U4jJFg&_nc_ss=7b289&oh=00_AQSJqdMdJRh23omZ-q41VOjMV_n3RP5ZX4PNOaJUGjSNkg&oe=6AED8C6F","resized_image_url":"https://scontent.fkiv9-1.fna.fbcdn.net/v/t39.35426-6/466852442_1213814826575728_822135444306171132_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=y_tSSDtY2jsQ7kNvwFgagts&_nc_oc=AdoHwuYUmxrxQwPjPmIlJdjg2MMI70AzgBr1ROR4VD-f_EJU8ZcUakBm-mPrYXTsLKI&_nc_zt=14&_nc_ht=scontent.fkiv9-1.fna&_nc_gid=hYFmbpSedWibIJl8U4jJFg&_nc_ss=7b289&oh=00_AQQN_DzWBaNr2H_eIxDi081NgHyFJdQZcRXkSP-syYQ4_w&oe=6AED8AA0","watermarked_resized_image_url":""},{"image_crops":[],"original_image_url":"https://scontent.fkiv9-1.fna.fbcdn.net/v/t39.35426-6/466461720_1963440077402745_9151971351718748968_n.jpg?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=aTN89bHPwzUQ7kNvwHwplOW&_nc_oc=AdrBdmBlkroI3UzzbD8c2iivxF0xeDwwWif38K5YLg0mE6Qp60yfQgNIq1ia4xGYvLk&_nc_zt=14&_nc_ht=scontent.fkiv9-1.fna&_nc_gid=hYFmbpSedWibIJl8U4jJFg&_nc_ss=7b289&oh=00_AQTCT6bROrRIiOthJWGGdlP1fCmQ8Y6evg-BpUI2id319A&oe=6AED5A50","resized_image_url":"https://scontent.fkiv9-2.fna.fbcdn.net/v/t39.35426-6/466914502_874097398246367_3567926893895932369_n.jpg?stp=dst-jpg_s600x600_tt6&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=c53f8f&_nc_ohc=avExXCrgkS8Q7kNvwHeDB5h&_nc_oc=Ado4HMYFjmj-3sIqOZDRHYpOQZGJj0rTJn1aqVeY0VSPkT1vvB_2Nh